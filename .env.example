# ---------------------------------------------------------------------------
# Assayel International Academy Tent Pegging Competition Management and
# Scoring System. Copy this file to .env.local and fill in real values.
# Never commit secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Neon (production): use the POOLED connection string from the Neon
# dashboard (the one with "-pooler" in the hostname), not the direct one.
# Vercel can run many serverless function instances at once, each holding
# its own small connection pool (see src/db/index.ts); the pooled endpoint
# is built for exactly that, the direct one is not.
#   postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require
# Local Postgres:    postgresql://postgres:postgres@localhost:5432/aia
DATABASE_URL=

# Driver selection. "neon" uses Neon's serverless WebSocket pool driver
# (required on Vercel: this app runs real transactions, which Neon's
# lighter HTTP driver cannot do). "pg" uses node-postgres (for local
# Postgres, or any non-Neon host). Leave empty to auto-detect from the host
# name in DATABASE_URL.
DATABASE_DRIVER=

# 32+ byte random string used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# One-time bootstrap credentials for the very first administrator account.
# Used only by `npm run db:bootstrap-admin`, then should be removed.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: separate database used by integration tests. Integration tests are
# skipped when this is not set. NEVER point this at a production database:
# the test harness truncates every table.
TEST_DATABASE_URL=

# Optional: separate database used by the Playwright end to end suite.
# Falls back to TEST_DATABASE_URL. NEVER point this at a production database:
# the suite truncates every table before it runs.
E2E_DATABASE_URL=
